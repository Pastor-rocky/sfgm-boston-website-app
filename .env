# SFGM Boston Bible School - Environment Variables
# IMPORTANT: This is the ACTIVE database configuration

# ============================================
# REQUIRED - Database Configuration
# ============================================
# ACTIVE DATABASE: boston_ministry (with PastorRocky user)
# DO NOT USE: sfgm_boston_dev (different database, ignore it)
# 
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://rocky@localhost:5432/boston_ministry

# ============================================
# Server Configuration
# ============================================
PORT=56000
NODE_ENV=development

# ============================================
# Optional - AI/ML Services
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
AZURE_TTS_KEY=your-azure-tts-key-here
AZURE_TTS_REGION=eastus
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============================================
# Optional - External Monitoring
# ============================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Optional - SMS/Communication Services
# ============================================
SIMPLETEXTING_API_TOKEN=your-simpletexting-token-here
SIMPLETEXTING_ACCOUNT_ID=your-account-id-here

# ============================================
# Optional - Email Delivery (Final Exam Essays)
# ============================================
EMAIL_ENABLED=false
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
ESSAY_REVIEW_EMAIL=pastor_rocky@sfgmboston.com
