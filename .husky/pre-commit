#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged to check and fix code before commit
npx lint-staged

# Prevent committing .env files
if git diff --cached --name-only | grep -q '\.env$'; then
  echo "❌ ERROR: .env file is staged for commit!"
  echo "Run: git reset HEAD .env"
  echo "Make sure .env is in .gitignore"
  exit 1
fi

# Check for large files (>10MB)
large_files=$(git diff --cached --name-only | xargs ls -la 2>/dev/null | awk '{if ($5 > 10485760) print $9, "(" $5/1048576 "MB)"}')
if [ ! -z "$large_files" ]; then
  echo "⚠️  WARNING: Large files detected:"
  echo "$large_files"
  echo ""
  read -p "Continue with commit? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi
