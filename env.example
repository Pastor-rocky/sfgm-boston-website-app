# SFGM Boston Bible School - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED - Database Configuration
# ============================================
# PostgreSQL connection string (Neon, Supabase, or self-hosted)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/sfgm_boston

# Database connection pool size (optional, default: 30 for upgraded Render + Neon)
# Recommended values:
# - Development: 5-10
# - Launch (200-500 students): 20-25
# - Growth (500-1,000 students): 25-30
# - Scale (1,000+ students): 30-40
# Default: 30 (upgraded capacity; use with Render Standard/Pro + Neon Launch/Scale)
# DB_POOL_SIZE=30

# ============================================
# Server Configuration
# ============================================
# Port for the Express server (default: 55555)
PORT=55555

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Optional - AI/ML Services
# ============================================
# OpenAI API Key (for TTS and AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure Text-to-Speech (alternative to OpenAI TTS)
# Get from: https://azure.microsoft.com/en-us/services/cognitive-services/text-to-speech/
AZURE_TTS_KEY=your-azure-tts-key-here
AZURE_TTS_REGION=eastus

# ElevenLabs API Key (alternative TTS provider)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# DeepSeek API Key (for Bible Study AI features)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============================================
# Optional - External Monitoring
# ============================================
# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Optional - SMS/Communication Services
# ============================================
# SimpleTexting API (for SMS notifications)
# Get from: https://www.simpletexting.com/
SIMPLETEXTING_API_TOKEN=your-simpletexting-token-here
SIMPLETEXTING_ACCOUNT_ID=your-account-id-here

# ============================================
# Optional - Email Delivery (Final Exam Essays)
# ============================================
# EmailJS is used to forward essay submissions to the review inbox.
# Set EMAIL_ENABLED=true to allow outbound messages in production.
EMAIL_ENABLED=false

# Postmark (recommended)
POSTMARK_SERVER_API_TOKEN=your-postmark-server-api-token
POSTMARK_FROM_EMAIL=pastor_rocky@sfgmboston.com
POSTMARK_FROM_NAME=SFGM Boston Bible School
# Optional: defaults to "outbound"
POSTMARK_MESSAGE_STREAM=outbound

# Where essay submissions go (defaults to pastor_rocky@sfgmboston.com)
ESSAY_REVIEW_EMAIL=pastor_rocky@sfgmboston.com

# Where admin registration notifications go (defaults to pastor_rocky@sfgmboston.com)
ADMIN_NOTIFICATION_EMAIL=pastor_rocky@sfgmboston.com

# Public site URL for password reset links (defaults to https://sfgmboston.com)
# APP_URL=https://sfgmboston.com

# Admin panel password (required in production; dev falls back to "123" if unset)
# ADMIN_PASSWORD=your-strong-admin-password

# ============================================
# Social Sign-In — Google (free) & Apple ($99/yr dev account)
# ============================================
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:56000/api/auth/google/callback

# APPLE_CLIENT_ID=com.sfgmboston.web
# APPLE_TEAM_ID=your_apple_team_id
# APPLE_KEY_ID=your_apple_key_id
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CALLBACK_URL=http://localhost:56000/api/auth/apple/callback

# ============================================
# Instructor Portal — Twilio SMS
# ============================================
SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx  # Required for US A2P 10DLC (add number to sender pool)

# ============================================
# Instructor Portal — Zoom (Server-to-Server OAuth)
# ============================================
ZOOM_ENABLED=false
# ZOOM_ACCOUNT_ID=your_zoom_account_id
# ZOOM_CLIENT_ID=your_zoom_client_id
# ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ============================================
# Instructor Portal — Google Calendar
# ============================================
GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=...
# GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/.../public/basic.ics
# GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# EmailJS (primary — used for registration, password reset, essays, birthdays)
# EMAILJS_SERVICE_ID=service_bhhbgpr
# EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# EMAILJS_PRIVATE_KEY=your-emailjs-private-key
# EMAILJS_TEMPLATE_ID=your-essay-template-id
# EMAILJS_WELCOME_TEMPLATE_ID=your-welcome-template-id
# EMAILJS_ADMIN_TEMPLATE_ID=your-admin-template-id
# EMAILJS_BIRTHDAY_TEMPLATE_ID=your-birthday-template-id
# EMAILJS_PASSWORD_RESET_TEMPLATE_ID=optional-dedicated-reset-template-id

# Postmark (optional fallback if configured)

# ============================================
# Notes
# ============================================
# - DATABASE_URL is REQUIRED - the app will not start without it
# - All other variables are optional and will use defaults or disable features if not set
# - Never commit .env files to version control
# - For production, use secure secret management (AWS Secrets Manager, etc.)



# ============================================
# Optional - Google OAuth
# ============================================
# Google OAuth 2.0 credentials for "Sign in with Google"
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://sfgmboston.com/api/auth/google/callback
# For local development, use: http://localhost:56000/api/auth/google/callback

# ============================================
# Optional - YouTube Live Broadcast (/live) — AUTO-DETECT
# ============================================
# One-time setup: when you go live on YouTube, /live updates automatically.
#
# 1) Google Cloud Console → APIs & Services → Library → enable "YouTube Data API v3"
# 2) Credentials → Create API Key → restrict to YouTube Data API v3
# 3) Add these to Render:
YOUTUBE_API_KEY=your-google-api-key-here
YOUTUBE_CHANNEL_HANDLE=sfgmbostonma
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@sfgmbostonma
#
# Optional overrides (usually not needed):
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx
# YOUTUBE_LIVE_VIDEO_ID=
# YOUTUBE_LIVE_POLL_SECONDS=45
# YOUTUBE_LIVE_TITLE=SFGM Boston Live
# YOUTUBE_LIVE_SUBTITLE=Wednesday Family Night & Sunday Worship

# ============================================
# Optional - OBS iPad Controller (church streaming PC)
# ============================================
# Generate a long random string — same value on Render AND church PC .env
# OBS_AGENT_TOKEN=your-long-random-secret-here
# Church PC only (npm run obs:agent):
# OBS_RELAY_URL=https://sfgmboston.com
# OBS_WS_HOST=127.0.0.1
# OBS_WS_PORT=4455
# OBS_WS_PASSWORD=your_obs_websocket_password
# OBS_AGENT_LABEL=Church Sanctuary PC
