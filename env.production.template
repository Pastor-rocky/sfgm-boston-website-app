# SFGM Boston Bible School - Production Environment Variables
# Copy this file to .env.production and fill in your actual production values
# DO NOT commit this file with real credentials

# ============================================
# REQUIRED - Database Configuration
# ============================================
# Production PostgreSQL connection string
# Use connection pooling for production (e.g., Neon's pooled connection)
DATABASE_URL=postgresql://user:password@prod-host:5432/sfgm_boston_prod

# ============================================
# Server Configuration
# ============================================
# Production port (usually 80, 443, or provided by hosting platform)
PORT=55555

# MUST be set to production
NODE_ENV=production

# ============================================
# Production AI/ML Services
# ============================================
# Production OpenAI API Key
OPENAI_API_KEY=sk-prod-key-here

# Production Azure TTS (if using)
AZURE_TTS_KEY=prod-azure-key-here
AZURE_TTS_REGION=eastus

# Production DeepSeek API Key
DEEPSEEK_API_KEY=prod-deepseek-key-here

# ============================================
# Production Monitoring
# ============================================
# Sentry DSN for production error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Production SMS/Communication
# ============================================
SIMPLETEXTING_API_TOKEN=prod-token-here
SIMPLETEXTING_ACCOUNT_ID=prod-account-id-here

# ============================================
# Security Notes
# ============================================
# - Use strong, unique passwords for all services
# - Rotate API keys regularly
# - Use environment-specific secrets (never share dev/prod keys)
# - Enable SSL/TLS for database connections
# - Use connection pooling for database
# - Set up automated backups for database
# - Monitor API usage and set rate limits


